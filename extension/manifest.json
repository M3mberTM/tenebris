{
	"manifest_version": 3,
	"name": "Tenebris",
	"version": "1.0.0",
	"description": "Simple extension that changes the browser theme and simplifies new page",
	"permissions": ["bookmarks", "favicon"],
	"chrome_url_overrides": {
		"newtab": "newtab.html"
	},
	"content_scripts": [
		{
			"matches": ["https://www.google.com/search*"],
			"css": ["search.css"],
			"run_at": "document_start"
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["images/*.png"],
			"matches": ["https://www.google.com/*"]
		},
		{
			"resources": ["_favicon/*"],
			"matches": ["<all_urls>"],
			"extension_ids": ["*"]
		}
	]
}
